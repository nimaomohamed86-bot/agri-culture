DATABASE_URL="postgresql://user:password@your-neon-host/neondb?sslmode=require"
# For Prisma migrations, use the direct (unpooled) URL if needed:
# DATABASE_URL_UNPOOLED="postgresql://user:password@your-neon-direct-host/neondb?sslmode=require"
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_EXPIRES_IN="7d"
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Email (optional - uses console fallback in dev)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Agri Supply <noreply@agrisupply.com>"

# Cloudinary (optional - uses local uploads if not set)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
